# Copy this file to .env in the repository root, then fill in your local values.
# Do not commit .env or share database credentials.
# Run ServerApp with the repository root as its working directory.
# Existing process environment variables override values from .env.

QUIZ_SERVER_HOST=127.0.0.1
QUIZ_SERVER_PORT=9090

# The database name must be exactly quiz_game.
# Put credentials below, never inside the JDBC URL.
QUIZ_DB_URL=jdbc:mysql://127.0.0.1:3306/quiz_game
QUIZ_DB_USER=
QUIZ_DB_PASSWORD=
